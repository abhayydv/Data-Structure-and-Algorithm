class Solution {
    public int maximumProduct(int[] nums) {
        Arrays.sort(nums);
        int n = nums.length;

        int ans1 = Math.abs(nums[0])*Math.abs(nums[1])*nums[n-1];
        int ans2 = nums[n-1]*nums[n-2]*nums[n-3];
        
        if(ans1 > ans2){
            return ans1;
        }

        return ans2;
    }
}
