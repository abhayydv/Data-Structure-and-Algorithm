import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		// your code goes here
		Scanner sc = new Scanner(System.in);
		
		int t = sc.nextInt();
		
		int max = Integer.MIN_VALUE;
		
		
		while(t-- > 0){
		    int x = sc.nextInt();
		    int y = sc.nextInt();
		    
		    max = Math.max(max,x+y);
            		    
		}
		
		System.out.println(max);

	}
}
