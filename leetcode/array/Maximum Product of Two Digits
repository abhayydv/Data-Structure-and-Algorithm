class Solution {
    public int maxProduct(int n) {
        String s = ""+n;
        int n1 = 0;
        int n2 = 0;

        for(int i = 1; i<s.length(); i++){
            int val = s.charAt(i) - '0';
            if(val > (s.charAt(n1) - '0')){
                n1 = i;
            }
        }
        int val1 = -1;
        for(int i = 0; i<s.length(); i++){
            int val = s.charAt(i) - '0';
            if(val > val1 && i != n1){
                n2 = i;
                val1 = val;
            }
        }

        int v1 = s.charAt(n1) - '0';
        int v2 = s.charAt(n2) - '0';

        return v1*v2;
    }
}
