import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		// your code goes here
		Scanner sc = new Scanner(System.in);
		
		String s = sc.next();
		String t = sc.next();
		
// 		int count = 0;
		
		int i = s.length() - 1;
		int j = t.length() - 1;
        
        while(i >= 0 && j >= 0){
            char ch1 = s.charAt(i);
            char ch2 = t.charAt(j);
            
            if(ch1 != ch2){
                break;
            }
            i--;
            j--;
            // count++;
        }
        
        // int totalMovesS = s.length() - count;
        // int totalMovesT = t.length() - count;
        
        // System.out.println(totalMovesS+totalMovesT);
        System.out.println(i+j+2);
        
	}
}
