class Solution {
    public int[] resultArray(int[] nums) {
        int n = nums.length;

        ArrayList<Integer> list1 = new ArrayList<>();
        ArrayList<Integer> list2 = new ArrayList<>();
        list1.add(nums[0]);
        list2.add(nums[1]);

        int a = 0;
        int b = 0;
        for(int i = 2; i<n; i++){
            int val1 = list1.get(list1.size()-1);
            int val2 = list2.get(list2.size()-1);

            if(val1 > val2){
                list1.add(nums[i]);
            }else{
                list2.add(nums[i]);
            }
        }

        int result[] = new int[n];
        a = 0;
        int i = 0;
        while(a < list1.size()){
            result[i] = list1.get(a++);
            i++;
        }
        b = 0;
        while(b < list2.size()){
            result[i] = list2.get(b++);
            i++;
        }

        return result;
    }
}
