    public boolean dfs(List<Integer> list[],boolean vis[],int src,int dest){
        if(src == dest){
            return true;
        }
        vis[src] = true;

        for(int i = 0; i<list[src].size(); i++){
            int neigh = list[src].get(i);
            if(!vis[neigh] && dfs(list,vis,neigh,dest)){
                return true;
            }
        }

        return false;
    }
    public void createList(List<Integer> list[], int mat[][]){
        for(int i = 0; i<list.length; i++){
            list[i] = new ArrayList();
        }

        for(int i = 0; i<mat.length; i++){
            int first = mat[i][0];
            int second = mat[i][1];

            list[first].add(second);
            list[second].add(first);
        }
    }

}
