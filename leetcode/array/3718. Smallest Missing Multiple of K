class Solution {
    public int missingMultiple(int[] nums, int k) {
        HashMap<Integer,Integer> map = new HashMap<>();

        for(int val : nums){
            map.put(val,map.getOrDefault(val,0)+1);
        }

        int ans = -1;

        for(int i = k; ; i += k){
            if(!map.containsKey(i)){
                ans = i;
                break;
            }
        }

        return ans;
    }
}
