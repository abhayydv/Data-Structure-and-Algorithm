import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		// your code goes here
		Scanner sc = new Scanner(System.in);
		
		int t = sc.nextInt();
		
		while(t-- > 0){
		    int n = sc.nextInt();
		    int m = sc.nextInt();
		    
		    
		    int left = n;
		    int right = n;
		    
		    if(m >= left){
		        System.out.println(right);
		    }else{
		        int l = left - m;
		        System.out.println(right + l);
		    }
		}

	}
}
