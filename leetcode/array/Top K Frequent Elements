class Solution {
    public class Val implements Comparable<Val>{
        int key;
        int freq;

        public Val(int key,int freq){
            this.key = key;
            this.freq = freq;
        }

        @Override
        public int compareTo(Val v){
            return v.freq - this.freq;
        }
    }
    public int[] topKFrequent(int[] nums, int k) {
        HashMap<Integer,Integer> map = new HashMap<>();

        for(int val : nums){
            map.put(val,map.getOrDefault(val,0)+1);
        }

        PriorityQueue<Val> pq = new PriorityQueue<>();

        for(int key : map.keySet()){
            pq.add(new Val(key,map.get(key)));
        }

        int ans[] = new int[k];

        int i = 0;

        while(k-- > 0 && !pq.isEmpty()){
            ans[i++] = pq.poll().key;
        }
        
        return ans;
    }
}
