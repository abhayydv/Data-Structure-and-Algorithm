class Solution {
    public List<Integer> findMissingElements(int[] nums) {
        List<Integer> list = new ArrayList<>();
        Arrays.sort(nums);

        HashSet<Integer> set = new HashSet<>();
        for(int val : nums){
            set.add(val);
        }

        int min = nums[0];
        int max = nums[nums.length - 1];

        for(int i = min+1; i<max; i++){
            if(!set.contains(i)){
                list.add(i);
            }
        }

        return list;
    }
}
